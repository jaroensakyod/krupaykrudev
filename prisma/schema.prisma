// krupay — base auth schema (Phase 0)
// Domain tables (products, orders, ledger, ...) are added per-phase via migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  BUYER
  CREATOR
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum CreatorVerificationStatus {
  UNVERIFIED
  BASIC
  VERIFIED
  RESTRICTED
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  emailVerified DateTime?  @map("email_verified_at")
  passwordHash  String?    @map("password_hash")
  displayName   String     @map("display_name")
  avatarUrl     String?    @map("avatar_url")
  role          UserRole   @default(BUYER)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  accounts Account[]
  sessions Session[]

  creatorProfile CreatorProfile?

  @@index([status])
  @@map("users")
}

model CreatorProfile {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @unique @map("user_id") @db.Uuid
  slug               String                    @unique
  displayName        String                    @map("display_name")
  bio                String?
  profileImageUrl    String?                   @map("profile_image_url")
  bannerUrl          String?                   @map("banner_url")
  subjects           String[]                  @default([])
  gradeLevels        String[]                  @map("grade_levels") @default([])
  specialties        String[]                  @default([])
  socialLinks        Json?                     @map("social_links")
  verificationStatus CreatorVerificationStatus @default(UNVERIFIED) @map("verification_status")
  trustLevel         Int                       @default(0) @map("trust_level")
  termsAcceptedAt    DateTime?                 @map("terms_accepted_at")
  termsVersion       String?                   @map("terms_version")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  deletedAt          DateTime?                 @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
