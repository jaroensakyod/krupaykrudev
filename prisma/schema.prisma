// krupay — base auth schema (Phase 0)
// Domain tables (products, orders, ledger, ...) are added per-phase via migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  BUYER
  CREATOR
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum CreatorVerificationStatus {
  UNVERIFIED
  BASIC
  VERIFIED
  RESTRICTED
}

// ── Catalog (Phase 2) ───────────────────────────────────────────

enum ProductStatus {
  DRAFT
  PROCESSING
  READY_FOR_REVIEW
  UNDER_REVIEW
  PUBLISHED
  REJECTED
  NEEDS_CHANGES
  SUSPENDED
  ARCHIVED
}

enum ModerationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum ProductVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

// Taxonomy — configurable via Admin, never hard-coded in UI (PRD §10-11)
model ProductType {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  nameTh    String  @map("name_th")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  products Product[]

  @@map("product_types")
}

model Subject {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  nameTh    String  @map("name_th")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  topics  Topic[]
  products Product[]

  @@map("subjects")
}

model Grade {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  nameTh    String  @map("name_th")
  group     String?
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  products Product[]

  @@map("grades")
}

model Topic {
  id        Int     @id @default(autoincrement())
  subjectId Int     @map("subject_id")
  parentId  Int?    @map("parent_id")
  nameTh    String  @map("name_th")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  subject  Subject @relation(fields: [subjectId], references: [id])
  parent   Topic?  @relation("TopicTree", fields: [parentId], references: [id])
  children Topic[] @relation("TopicTree")
  products Product[]

  @@index([subjectId])
  @@map("topics")
}

model Curriculum {
  id     Int    @id @default(autoincrement())
  code   String @unique
  nameTh String @map("name_th")

  products Product[]

  @@map("curricula")
}

// Exam taxonomy (PRD §11: TGAT/TPAT/A-Level/สอวน./Entrance/School Exam/Other)
model Exam {
  id     Int    @id @default(autoincrement())
  code   String @unique
  nameTh String @map("name_th")
  sortOrder Int @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")

  products Product[]

  @@map("exams")
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique

  products ProductTag[]

  @@map("tags")
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  creatorId        String            @map("creator_id") @db.Uuid
  title            String
  slug             String            @unique
  shortDescription String?           @map("short_description")
  description      String?
  productTypeId    Int               @map("product_type_id")
  subjectId        Int               @map("subject_id")
  primaryGradeId   Int               @map("primary_grade_id")
  curriculumId     Int?              @map("curriculum_id")
  topicId          Int?              @map("topic_id")
  examId           Int?              @map("exam_id")
  difficulty       String?
  language         String            @default("th")
  price            Decimal           @default(0) @db.Decimal(10, 2)
  currency         String            @default("THB")
  status           ProductStatus     @default(DRAFT)
  moderationStatus ModerationStatus  @default(NOT_SUBMITTED) @map("moderation_status")
  visibility       ProductVisibility @default(PRIVATE)
  publishedAt      DateTime?         @map("published_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  creator     CreatorProfile @relation(fields: [creatorId], references: [id])
  productType ProductType    @relation(fields: [productTypeId], references: [id])
  subject     Subject        @relation(fields: [subjectId], references: [id])
  grade       Grade          @relation(fields: [primaryGradeId], references: [id])
  curriculum  Curriculum?    @relation(fields: [curriculumId], references: [id])
  topic       Topic?         @relation(fields: [topicId], references: [id])
  exam        Exam?          @relation(fields: [examId], references: [id])
  versions    ProductVersion[]
  tags        ProductTag[]
  copyrightDeclarations CopyrightDeclaration[]
  files       ProductFile[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  wishlistItems WishlistItem[]

  @@index([creatorId, status])
  @@index([status])
  @@map("products")
}

// ห้าม overwrite history ที่จำเป็นต่อ dispute/audit (PRD §12)
model ProductVersion {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  versionNumber Int      @map("version_number")
  changeSummary String?  @map("change_summary")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, versionNumber])
  @@map("product_versions")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     Int    @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
  @@map("product_tags")
}

// ── Trust & Moderation (Phase 5) ────────────────────────────────

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationCaseType {
  PRODUCT_REVIEW
  COPYRIGHT
  FRAUD
  USER_REPORT
  PAYMENT_DISPUTE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportReason {
  COPYRIGHT
  MISLEADING
  BROKEN_FILE
  INAPPROPRIATE
  SPAM
  DUPLICATE
  OTHER
}

enum StrikeSeverity {
  LOW
  MEDIUM
  HIGH
}

// ── Files (Phase 3) ─────────────────────────────────────────────

enum FileRole {
  ORIGINAL
  BONUS
  ANSWER
  SUPPORTING
  COVER
}

enum ScanStatus {
  PENDING
  CLEAN
  FAILED
}

// TASK-034: original files ห้าม public — เข้าถึงผ่าน signed URL เท่านั้น (PRD §13-14)
model ProductFile {
  id               String     @id @default(uuid()) @db.Uuid
  productId        String     @map("product_id") @db.Uuid
  storageKey       String     @map("storage_key")
  originalFilename String     @map("original_filename")
  mimeType         String     @map("mime_type")
  fileSize         Int        @map("file_size")
  sha256Hash       String     @map("sha256_hash")
  fileRole         FileRole   @default(ORIGINAL) @map("file_role")
  scanStatus       ScanStatus @default(PENDING) @map("scan_status")
  createdAt        DateTime   @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  preview ProductPreview?

  @@index([sha256Hash])
  @@index([productId])
  @@map("product_files")
}

// TASK-035: preview แยกจาก original — อยู่ public-safe path (PRD §16)
model ProductPreview {
  id               String   @id @default(uuid()) @db.Uuid
  fileId           String   @unique @map("file_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  storageKey       String   @map("storage_key")
  mimeType         String   @map("mime_type")
  width            Int?
  height           Int?
  watermarkApplied Boolean  @default(false) @map("watermark_applied")
  createdAt        DateTime @default(now()) @map("created_at")

  file ProductFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_previews")
}

// TASK-038: log ทุกการดาวน์โหลด (PRD §42)
model DownloadEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  orderId   String?  @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([userId])
  @@map("download_events")
}

// ── Commerce (Phase 7) ──────────────────────────────────────────
// (AI section ต่อด้านล่าง — ทุก AI call ผ่าน AI Gateway เท่านั้น PRD §22)

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum LicenseType {
  PERSONAL
}

// TASK-070: cart ต่อผู้ใช้ (guest ซื้อไม่ได้ตาม PRD §5)
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  items CartItem[]
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @unique @map("product_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

// TASK-072/073: order + snapshot — ห้าม mutate historical monetary snapshot (PRD §65)
model Order {
  id          String      @id @default(uuid()) @db.Uuid
  buyerId     String      @map("buyer_id") @db.Uuid
  status      OrderStatus @default(PENDING_PAYMENT)
  subtotal    Decimal     @db.Decimal(10, 2)
  discountTotal Decimal   @default(0) @map("discount_total") @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  currency    String      @default("THB")
  paymentStatus String    @default("PENDING") @map("payment_status")
  createdAt   DateTime    @default(now()) @map("created_at")
  paidAt      DateTime?   @map("paid_at")

  items    OrderItem[]
  payments Payment[]
  buyer    User        @relation(fields: [buyerId], references: [id])

  @@index([buyerId, status])
  @@map("orders")
}

model OrderItem {
  id              String      @id @default(uuid()) @db.Uuid
  orderId         String      @map("order_id") @db.Uuid
  productId       String      @map("product_id") @db.Uuid
  creatorId       String      @map("creator_id") @db.Uuid
  title           String
  unitPrice       Decimal     @map("unit_price") @db.Decimal(10, 2)
  platformFee     Decimal     @map("platform_fee") @db.Decimal(10, 2)
  creatorAmount   Decimal     @map("creator_amount") @db.Decimal(10, 2)
  productVersionId String     @map("product_version_id") @db.Uuid
  licenseType     LicenseType @default(PERSONAL) @map("license_type")

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  creator     CreatorProfile @relation(fields: [creatorId], references: [id])
  entitlement Entitlement?
  review      Review?

  @@index([orderId])
  @@map("order_items")
}

// TASK-074/076/077: payment — backend verify เท่านั้น ห้ามเชื่อ client redirect
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String        @default("mock")
  providerPaymentId String        @unique @map("provider_payment_id")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("THB")
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?     @map("paid_at")
  rawReference      String?       @map("raw_reference")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

// TASK-078: entitlement คือ source of truth ของสิทธิ์ดาวน์โหลด (PRD §41)
model Entitlement {
  id         String      @id @default(uuid()) @db.Uuid
  buyerId    String      @map("buyer_id") @db.Uuid
  orderItemId String     @unique @map("order_item_id") @db.Uuid
  productId  String      @map("product_id") @db.Uuid
  licenseType LicenseType @default(PERSONAL) @map("license_type")
  grantedAt  DateTime    @default(now()) @map("granted_at")
  revokedAt  DateTime?   @map("revoked_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  buyer     User      @relation(fields: [buyerId], references: [id])

  @@unique([buyerId, productId])
  @@index([buyerId])
  @@map("entitlements")
}

// TASK-037 config: commission แก้ได้ ห้าม hard-code (PRD §37)
model PlatformFeeRule {
  id       Int     @id @default(autoincrement())
  name     String
  ratePct  Decimal @map("rate_pct") @db.Decimal(5, 2)
  isActive Boolean @default(true) @map("is_active")

  @@map("platform_fee_rules")
}

// ── Finance (Phase 8) ───────────────────────────────────────────

enum LedgerEntryType {
  SALE
  PLATFORM_FEE
  PAYMENT_FEE
  CREATOR_EARNING
  REFUND
  PAYOUT
  ADJUSTMENT
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

// TASK-080: immutable ledger — ห้าม hard delete, ห้าม mutate (PRD §36, §65)
// Balance derive จาก entries เสมอ — ห้ามคำนวณจาก Order ตรง ๆ (PRD §36)
model LedgerEntry {
  id                 String           @id @default(uuid()) @db.Uuid
  transactionGroupId String           @map("transaction_group_id")
  entryType          LedgerEntryType  @map("entry_type")
  direction          LedgerDirection
  accountType        String           @map("account_type") // CREATOR | PLATFORM
  accountId          String           @map("account_id") // users.id หรือ "PLATFORM"
  amount             Decimal          @db.Decimal(10, 2)
  currency           String           @default("THB")
  orderId            String?          @map("order_id") @db.Uuid
  payoutId           String?          @map("payout_id") @db.Uuid
  refundId           String?          @map("refund_id") @db.Uuid
  // เงินเข้า pending ก่อน แล้วพร้อมถอนเมื่อครบ hold period
  availableAt        DateTime?        @map("available_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  payout Payout?  @relation(fields: [payoutId], references: [id])
  refund Refund?  @relation(fields: [refundId], references: [id])

  @@unique([transactionGroupId, entryType, accountId])
  @@index([accountType, accountId])
  @@map("ledger_entries")
}

// TASK-086/087
enum PayoutStatus {
  REQUESTED
  REVIEWING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Payout {
  id               String       @id @default(uuid()) @db.Uuid
  creatorUserId    String       @map("creator_user_id") @db.Uuid
  amount           Decimal      @db.Decimal(10, 2)
  method           String       @default("manual_transfer")
  status           PayoutStatus @default(REQUESTED)
  requestedAt      DateTime     @default(now()) @map("requested_at")
  processedAt      DateTime?    @map("processed_at")
  processedBy      String?      @map("processed_by") @db.Uuid
  providerReference String?     @map("provider_reference")

  entries LedgerEntry[]

  @@index([creatorUserId, status])
  @@map("payouts")
}

// TASK-084
enum RefundStatus {
  REQUESTED
  COMPLETED
  REJECTED
}

model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  amount      Decimal      @db.Decimal(10, 2)
  reason      String
  status      RefundStatus @default(REQUESTED)
  requestedBy String       @map("requested_by") @db.Uuid
  reviewedBy  String?      @map("reviewed_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")

  entries LedgerEntry[]

  @@index([orderId])
  @@map("refunds")
}

// ── Analytics (Phase 10) — event-based, ไม่ใส่ PII (PRD §67) ────

// TASK-102: ทุก search เก็บเสมอ — โดยเฉพาะ result_count=0 (demand gap signal, PRD §29)
model SearchEvent {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @map("session_id")
  userId          String?  @map("user_id") @db.Uuid
  rawQuery        String   @map("raw_query")
  normalizedQuery String   @map("normalized_query")
  filtersJson     Json?    @map("filters_json")
  resultCount     Int      @map("result_count")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([resultCount])
  @@map("search_events")
}

// TASK-103-107: product funnel events
model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @map("event_type")
  sessionId  String   @map("session_id")
  userId     String?  @map("user_id") @db.Uuid
  productId  String?  @map("product_id") @db.Uuid
  creatorId  String?  @map("creator_id") @db.Uuid
  properties Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([productId, eventType])
  @@map("analytics_events")
}

// ── Buyer engagement (Phase 9) ──────────────────────────────────

// TASK-091: review เฉพาะ verified purchase — กันซ้ำต่อ order item (PRD §43)
model Review {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  buyerId     String   @map("buyer_id") @db.Uuid
  orderItemId String   @unique @map("order_item_id") @db.Uuid
  rating      Int      // 1-5
  title       String?
  body        String?
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([productId, buyerId])
  @@index([productId])
  @@map("reviews")
}

// TASK-092: wishlist (PRD §44)
model Wishlist {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @unique @map("user_id") @db.Uuid

  items  WishlistItem[]
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @unique @map("product_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("wishlist_items")
}

// TASK-094: in-app notifications (PRD §71)
enum NotificationType {
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_NEEDS_CHANGES
  NEW_SALE
  PAYMENT_SUCCESS
  PAYOUT_UPDATE
  REPORT_UPDATE
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  linkUrl   String?          @map("link_url")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

enum AiJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AiTaskType {
  PRODUCT_METADATA
  PRODUCT_SEO
  PRODUCT_QUALITY
  SUPPORT
  MODERATION_ASSIST
  SEARCH_ASSIST
  DEMAND_ANALYSIS
  CREATOR_ASSIST
}

// TASK-042/043: job log + cost/usage ต่อ call
model AiJob {
  id            String      @id @default(uuid()) @db.Uuid
  taskType      AiTaskType  @map("task_type")
  entityType    String      @map("entity_type")
  entityId      String      @map("entity_id")
  userId        String?     @map("user_id") @db.Uuid
  provider      String      @default("gemini")
  model         String
  promptVersion String      @map("prompt_version")
  inputHash     String      @map("input_hash")
  status        AiJobStatus @default(QUEUED)
  confidence    Float?
  outputJson    Json?       @map("output_json")
  error         String?
  inputTokens   Int?        @map("input_tokens")
  outputTokens  Int?        @map("output_tokens")
  estimatedCost Decimal     @default(0) @map("estimated_cost") @db.Decimal(12, 8)
  latencyMs     Int?        @map("latency_ms")
  createdAt     DateTime    @default(now()) @map("created_at")
  completedAt   DateTime?   @map("completed_at")

  @@index([inputHash, status])
  @@index([taskType, createdAt])
  @@map("ai_jobs")
}

// TASK-050: ก่อน Submit Creator ต้องยืนยันสิทธิ์ (PRD §46)
model CopyrightDeclaration {
  id                 String   @id @default(uuid()) @db.Uuid
  creatorId          String   @map("creator_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  declarationVersion String   @map("declaration_version")
  acceptedAt         DateTime @default(now()) @map("accepted_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("copyright_declarations")
}

// TASK-052: moderation case — รองรับ product review/copyright/fraud/report/dispute
model ModerationCase {
  id          String               @id @default(uuid()) @db.Uuid
  caseType    ModerationCaseType   @map("case_type")
  entityType  String               @map("entity_type")
  entityId    String               @map("entity_id")
  riskLevel   RiskLevel            @default(LOW) @map("risk_level")
  status      ModerationCaseStatus @default(OPEN)
  assignedTo  String?              @map("assigned_to") @db.Uuid
  resolution  String?
  createdAt   DateTime             @default(now()) @map("created_at")
  resolvedAt  DateTime?            @map("resolved_at")

  strikes Strike[]

  @@index([status, caseType])
  @@index([entityType, entityId])
  @@map("moderation_cases")
}

// TASK-055
model Report {
  id          String       @id @default(uuid()) @db.Uuid
  reporterId  String?      @map("reporter_id") @db.Uuid
  entityType  String       @map("entity_type")
  entityId    String       @map("entity_id")
  reason      ReportReason
  description String?
  status      ReportStatus @default(OPEN)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([status])
  @@map("reports")
}

// TASK-056: ห้าม ban จาก AI อย่างเดียว — enforcement ผ่าน policy/service (PRD §50)
model Strike {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  reason        String
  severity      StrikeSeverity @default(LOW)
  relatedCaseId String?        @map("related_case_id") @db.Uuid
  expiresAt     DateTime?      @map("expires_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  case ModerationCase? @relation(fields: [relatedCaseId], references: [id])

  @@index([userId])
  @@map("strikes")
}

// TASK-057: audit log สำหรับ critical actions (PRD §54)
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  beforeJson    Json?    @map("before_json")
  afterJson     Json?    @map("after_json")
  metadataJson  Json?    @map("metadata_json")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  emailVerified DateTime?  @map("email_verified_at")
  passwordHash  String?    @map("password_hash")
  displayName   String     @map("display_name")
  avatarUrl     String?    @map("avatar_url")
  role          UserRole   @default(BUYER)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  accounts Account[]
  sessions Session[]

  creatorProfile CreatorProfile?
  cart           Cart?
  orders         Order[]
  entitlements   Entitlement[]
  reviews        Review[]
  wishlist       Wishlist?
  notifications  Notification[]

  @@index([status])
  @@map("users")
}

model CreatorProfile {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @unique @map("user_id") @db.Uuid
  slug               String                    @unique
  displayName        String                    @map("display_name")
  bio                String?
  profileImageUrl    String?                   @map("profile_image_url")
  bannerUrl          String?                   @map("banner_url")
  subjects           String[]                  @default([])
  gradeLevels        String[]                  @map("grade_levels") @default([])
  specialties        String[]                  @default([])
  socialLinks        Json?                     @map("social_links")
  verificationStatus CreatorVerificationStatus @default(UNVERIFIED) @map("verification_status")
  trustLevel         Int                       @default(0) @map("trust_level")
  termsAcceptedAt    DateTime?                 @map("terms_accepted_at")
  termsVersion       String?                   @map("terms_version")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  deletedAt          DateTime?                 @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  products   Product[]
  orderItems OrderItem[]

  @@map("creator_profiles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
